{
  "description": "Existing boot regression contract plus private E1000 PHY-loopback diagnostic. Not N0 IRQ/netd acceptance; explicit E1000 device required.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/runtime_stress",
      "exec /app/ipc_parent",
      "exec /app/calc",
      "exec /app/./calc",
      "exec /app/ipc_parent",
      "exec /app/handle_test"
    ],
    "command_actions": {
      "exec /app/calc": [
        {
          "wait_marker": "calc> "
        },
        {
          "type_text": "410+3"
        },
        {
          "wait_marker": "[STDOUT] 413"
        },
        {
          "type_text": "700+1"
        },
        {
          "wait_marker": "[STDOUT] 701"
        },
        {
          "type_text": "exit"
        },
        {
          "wait_marker": "[EXEC] /app/calc returned code=0"
        }
      ],
      "exec /app/./calc": [
        {
          "wait_marker": "calc> "
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ctrl"
              },
              {
                "type": "qcode",
                "data": "c"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "exec: interrupted"
        }
      ],
      "exec /app/ipc_parent": [
        {
          "wait_marker": "ipc_parent: OK"
        },
        {
          "wait_marker": "[EXEC] /app/ipc_parent returned code=0"
        }
      ]
    }
  },
  "required": [
    {
      "marker": "[DISPLAY-LEASE] repeated acquire survives first close and revokes on last close OK",
      "claim": "display ownership survives multiple handles until final release",
      "source": "userspace/system_apps/handle_test/src/main.rs; kernel/src/drivers/display/mod.rs"
    },
    {
      "marker": "[DISPLAY-ACCESS] padded record, copy errors, clipped rect and revoked write OK",
      "claim": "display record and user-copy boundaries preserve ABI and ownership",
      "source": "userspace/system_apps/handle_test/src/main.rs; kernel/src/syscall/display.rs"
    },
    {
      "marker": "handle_test: OK",
