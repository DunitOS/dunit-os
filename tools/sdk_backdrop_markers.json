{
  "description": "SDK backdrop blur and rounded group clips: changing sampled background, no feedback, reload rollback, and actual framebuffer goldens.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-backdrop.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKBACKDROP] dark hash=",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.01
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-backdrop-dark.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKBACKDROP] changed hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-backdrop-changed.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKBACKDROP] light hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-backdrop-light.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKBACKDROP] restored hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-backdrop-restored.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKBACKDROP] ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKBACKDROP] dark hash=",
    "[SDKBACKDROP] light hash=",
    "[SDKBACKDROP] restored hash=",
    "[SDKBACKDROP] ok",
    "[GUI-EXIT] app=sdk_backdrop_fixture kind=0 code=0",
    "[SDKBACKDROP] changed hash=",
    "[SDKBACKDROP] scene rebuild and noop OK",
    "[SDKBACKDROP] invalid retained OK"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "gui_server: FAIL",
    "FAIL no frame done"
  ]
}
