{
  "description": "SDK stable-key DSS transitions, real wait-set animation frames, exact endpoints, global reduced motion and frame goldens.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-motion.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKMOTION] idle hash=",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.01
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-motion-idle.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKMOTION] active hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-motion-active.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKMOTION] restored hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-motion-restored.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKMOTION] reduced hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-motion-reduced.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKMOTION] ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKMOTION] idle hash=",
    "[SDKMOTION] restored hash=",
    "[SDKMOTION] reduced hash=",
    "[SDKMOTION] ok",
    "[GUI-EXIT] app=sdk_motion_fixture kind=0 code=0",
    "[SDKMOTION] active hash=",
    "[SDKMOTION] timed frames and timeout OK",
    "[SDKMOTION] invalid retained OK"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "gui_server: FAIL",
    "FAIL no frame done"
  ]
}
