{
  "description": "Geometry-bound SDK canvas: a configure during publication defers the old snapshot; maximize and restore each publish exactly one complete frame, with no automatic blank frame.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-canvas.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[CANVAS] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "a"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[CANVAS] old snapshot staged",
          "timeout": 30
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[CANVAS] maximize one complete canvas frame",
          "timeout": 60
        },
        {
          "delay_ms": 300
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[CANVAS] restore one complete canvas frame",
          "timeout": 60
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[GUI-EXIT] app=sdk_canvas_fixture kind=0 code=0",
          "timeout": 30
        }
      ]
    },
    "image_profile": "dwm"
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[CANVAS] ready",
    "[CANVAS] old snapshot staged",
    "[CANVAS] maximize one complete canvas frame",
    "[CANVAS] restore one complete canvas frame",
    "[CANVAS] close OK",
    "[GUI-EXIT] app=sdk_canvas_fixture kind=0 code=0",
    "[CANVAS] concurrent resize deferred without publication"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC",
    "[USER-FAULT]"
  ]
}
