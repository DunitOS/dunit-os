{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /system/bin/tcc /assets/tcc/file_dialog.c -o /tmp/c-gui -ldunit_ui",
      "exec /app/setup import-desktop /assets/tcc/file_dialog.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "[GUI-PRESENT] app=c_gui",
          "timeout": 60
        },
        {
          "delay_ms": 800
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/c-ui-picker-initial.ppm"
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "ret"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "ret"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[C-PICKER] selected real existing filtered file",
          "timeout": 30
        },
        {
          "wait_marker": "[GUI-EXIT] app=c_gui kind=0 code=0",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[GUI-PRESENT] app=c_gui",
    "[C-PICKER] selected real existing filtered file",
    "[GUI-EXIT] app=c_gui kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "tcc: error",
    "gui_server: FAIL",
    "setup: error:",
    "setup: fatal error",
    "[C-PICKER] failure"
  ]
}
