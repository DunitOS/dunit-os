{
  "run": {
    "cmd": [
      "exec /app/setup",
      "exec /app/setup get theme.desktop",
      "exec /app/setup set effects.anim_ms 180",
      "exec /app/setup get effects.anim_ms",
      "exec /app/setup set effects.anim_ms 99999",
      "exec /app/setup get effects.anim_ms",
      "exec /app/setup check",
      "exec /app/lua_spike",
      "exec /app/setup import /assets/dwm/themes/macos-light.toml",
      "exec /app/setup get theme.title_focused",
      "exec /app/setup set scripts.enabled true",
      "exec /app/setup get scripts.enabled"
    ],
    "command_actions": {
      "exec /app/setup": [
        {
          "wait_marker": "Select:"
        },
        {
          "type_text": "1"
        },
        {
          "wait_marker": "Select field:"
        },
        {
          "type_text": "1"
        },
        {
          "wait_marker": "New TOML value"
        },
        {
          "type_text": "\"#FF102030\""
        },
        {
          "wait_marker": "setup: staged"
        },
        {
          "type_text": "b"
        },
        {
          "type_text": "s"
        },
        {
          "wait_marker": "setup: saved"
        },
        {
          "type_text": "q"
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "theme.desktop = \"#FF102030\"",
    "effects.anim_ms = 180",
    "setup: check OK",
    "setup: error: invalid value or out of range; value was not changed",
    "[LUA] language OK",
    "[LUA] instruction-budget OK",
    "[LUA] allocation-budget OK",
    "[LUA] compatibility OK",
    "/app/lua_spike returned code=0",
    "theme.title_focused = \"#FFF7F7FA\"",
    "scripts.enabled = true"
  ],
  "forbidden": [
    "[PANIC]",
    "[LUA] FAIL",
    "setup: fatal error"
  ]
}
