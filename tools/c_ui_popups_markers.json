        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "ret"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "ret"}}}]}},
