  "required": [
    "[TERM-007] Starting main loop",
    "gui_server: desktop ready",
    "[GUI-PRESENT] app=c_gui",
    "[C-POPUP] invalid selection rejected",
    "[C-POPUP] menu action",
    "[C-POPUP] submenu action",
    "[C-POPUP] selected blue",
    "[C-POPUP] selection declined",
    "[C-POPUP] context action",
    "[C-POPUP] reset",
    "[C-POPUP] ok",
    "[GUI-EXIT] app=c_gui kind=0 code=0"
