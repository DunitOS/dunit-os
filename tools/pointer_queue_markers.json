{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/pointer_queue_test"
    ],
    "command_actions": {
      "exec /app/pointer_queue_test": [
        {
          "wait_marker": "[POINTERQ] sleeping; inject complete short click",
          "timeout": 30
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": true
                }
              }
            ]
          }
        },
        {
          "delay_ms": 40
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": false
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[POINTERQ] handover and queue OK",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[POINTERQ] access and failed-copy preservation OK",
    "[POINTERQ] short down/up retained while sleeping OK",
    "[POINTERQ] handover and queue OK",
    "[EXEC] /app/pointer_queue_test returned code=0",
    "[POINTERQ] start"
  ],
  "forbidden": [
    "[PANIC]",
    "[POINTERQ] FAIL",
    {
      "marker": "[USER-FAULT]",
      "after": "[POINTERQ] start"
    }
  ]
}
