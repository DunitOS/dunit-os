{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-vertical-slider.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] focus OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "up"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] up increases OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "end"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] end OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "up"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] endpoint no duplicate OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] home OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "pgup"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] page up OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "pgdn"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] page down OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 24,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 0,
            "repeat": 2,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 82,
            "y": 127,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 69,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": true
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] track click OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": 0,
            "y": -56,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] upward drag clamp OK",
          "timeout": 45
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": false
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] release OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 14,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": true
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] thumb grab no jump OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "esc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] escape cancels capture OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 127,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 85,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] cancelled move OK",
          "timeout": 45
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": false
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] cancelled release OK",
          "timeout": 45
        },
        {
          "delay_ms": 250
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-vertical-slider.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] tab skip and button OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] resize focus OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "shift"
              },
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "down"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] resized down decreases OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ret"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[VERTICAL-SLIDER] ok",
          "timeout": 45
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[VERTICAL-SLIDER] ready",
    "[VERTICAL-SLIDER] focus OK",
    "[VERTICAL-SLIDER] up increases OK",
    "[VERTICAL-SLIDER] end OK",
    "[VERTICAL-SLIDER] endpoint no duplicate OK",
    "[VERTICAL-SLIDER] home OK",
    "[VERTICAL-SLIDER] page up OK",
    "[VERTICAL-SLIDER] page down OK",
    "[VERTICAL-SLIDER] track click OK",
    "[VERTICAL-SLIDER] upward drag clamp OK",
    "[VERTICAL-SLIDER] release OK",
    "[VERTICAL-SLIDER] thumb grab no jump OK",
    "[VERTICAL-SLIDER] escape cancels capture OK",
    "[VERTICAL-SLIDER] cancelled move OK",
    "[VERTICAL-SLIDER] cancelled release OK",
    "[VERTICAL-SLIDER] tab skip and button OK",
    "[VERTICAL-SLIDER] resize focus OK",
    "[VERTICAL-SLIDER] resized down decreases OK",
    "[VERTICAL-SLIDER] ok",
    "[GUI-EXIT] app=sdk_vertical_slider_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
