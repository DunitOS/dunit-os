      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[DF-TEST] syscall+irq flags preserved",
    "setup: full desktop applied",
    "gui_server: desktop ready",
    "[CONSOLE] cli ready",
    "[CONSOLE] cli stdin stdout argv OK",
    "gui_terminal: child=/app/console command exited kind=0 code=0",
    "[GUI-EXIT] app=sdk_console_cli kind=0 code=0",
    "[CONSOLE] tui ready",
    "[CONSOLE] tui stdin stdout argv OK",
    "gui_terminal: child=/app/sdk_console_tui stopped on close",
    "[GUI-EXIT] app=sdk_console_tui kind=0 code=0",
    "[STDOUT] shellok",
    "gui_terminal: child=dsh stopped on close",
    "[GUI-EXIT] app=shell kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "panicked at",
    "gui_server: FAIL",
    "gui_terminal: FAIL",
    "gui_terminal: PANIC",
    "application failed:",
    {"marker": "[USER-FAULT]", "after": "[TERM-007] Starting main loop", "why": "Boot isolation faults precede terminal readiness; no desktop application faults are allowed."}
  ]
}
