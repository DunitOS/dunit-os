        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "s"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "s"}}}]}},
