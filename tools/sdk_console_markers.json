        {"delay_ms": 100},
        {"wait_marker": "[CONSOLE] cli stdin stdout argv OK", "timeout": 45},
        {"wait_marker": "gui_terminal: child=/app/console command exited kind=0 code=0", "timeout": 45},
        {"delay_ms": 300},
        {"execute": "screendump", "arguments": {"filename": "build/sdk-console-cli.ppm"}},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "meta_l"}}}, {"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "q"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "q"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "meta_l"}}}]}},
