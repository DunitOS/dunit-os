        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "l"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "l"}}}]}},
        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "l"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "l"}}}]}},
        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "o"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "o"}}}]}},
        {"delay_ms": 100},
