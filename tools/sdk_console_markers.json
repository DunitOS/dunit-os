        {"wait_marker": "[CONSOLE] cli ready", "timeout": 45},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "h"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "h"}}}]}},
        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "e"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "e"}}}]}},
        {"delay_ms": 100},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "l"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "l"}}}]}},
