{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /system/bin/tcc /assets/tcc/radio.c -o /tmp/c-gui -ldunit_ui",
      "exec /app/setup import-desktop /assets/tcc/radio.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {"wait_marker": "gui_server: desktop ready", "timeout": 60},
        {"wait_marker": "[GUI-PRESENT] app=c_gui", "timeout": 60},
        {"delay_ms": 1000},
        {"execute": "screendump", "arguments": {"filename": "build/c-ui-radio-initial.ppm"}},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "spc"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "spc"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "right"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "right"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 1 selected 1,0", "timeout": 30},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "ret"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "ret"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "right"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "right"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 2 selected 1,1", "timeout": 30},
        {"delay_ms": 1000},
        {"execute": "screendump", "arguments": {"filename": "build/c-ui-radio-selected.ppm"}},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "right"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "right"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 3 selected 1,0", "timeout": 30},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "left"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "left"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 4 selected 1,1", "timeout": 30},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "left"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "left"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 5 selected 0,1", "timeout": 30},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "left"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "left"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] change 6 selected 1,1", "timeout": 30},
        {"delay_ms": 1000},
        {"execute": "screendump", "arguments": {"filename": "build/c-ui-radio-updated.ppm"}},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "spc"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "spc"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "tab"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "tab"}}}]}},
        {"delay_ms": 150},
        {"execute": "input-send-event", "arguments": {"events": [{"type": "key", "data": {"down": true, "key": {"type": "qcode", "data": "ret"}}}, {"type": "key", "data": {"down": false, "key": {"type": "qcode", "data": "ret"}}}]}},
        {"delay_ms": 150},
        {"wait_marker": "[C-RADIO] ok", "timeout": 30},
        {"wait_marker": "[GUI-EXIT] app=c_gui kind=0 code=0", "timeout": 30}
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "gui_server: desktop ready",
    "[GUI-PRESENT] app=c_gui",
    "[C-RADIO] invalid group rejected",
    "[C-RADIO] change 1 selected 1,0",
    "[C-RADIO] change 2 selected 1,1",
    "[C-RADIO] change 3 selected 1,0",
    "[C-RADIO] change 4 selected 1,1",
    "[C-RADIO] change 5 selected 0,1",
    "[C-RADIO] change 6 selected 1,1",
    "[C-RADIO] ok",
    "[GUI-EXIT] app=c_gui kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "tcc: error",
    "gui_server: FAIL",
    "setup: error:",
    "setup: fatal error"
  ]
}
