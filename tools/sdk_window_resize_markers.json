{
  "description": "CONFIGURE arrives during painting: stale frame recovery, preserved maximize/restore placement, close and child status",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-resize.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKRESIZE] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "a"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKRESIZE] painting",
          "timeout": 30
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SDKRESIZE] recovered repaint OK",
          "timeout": 60
        },
        {
          "delay_ms": 300
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SDKRESIZE] restored placement OK",
          "timeout": 60
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[GUI-EXIT] app=sdk_resize_fixture kind=0 code=0",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKRESIZE] ready",
    "[SDKRESIZE] painting",
    "[SDKRESIZE] recovered repaint OK",
    "[SDKRESIZE] restored placement OK",
    "[SDKRESIZE] close OK",
    "[GUI-EXIT] app=sdk_resize_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
