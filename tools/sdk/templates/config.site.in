# Generated by tools/dunit_sdk.py. Configure with --host=x86_64-dunit
# and a distinct --build triplet; CONFIG_SITE alone does not enable cross mode.
# Update a project's config.sub if it rejects the dunit OS name. Do not replace
# the target with Linux, and do not cache untested runtime probes as successful.
dunit_sysroot=${shell_root}
CC="$$dunit_sysroot/bin/x86_64-dunit-cc"
AR="$$dunit_sysroot/bin/x86_64-dunit-ar"
STRIP="$$dunit_sysroot/bin/x86_64-dunit-strip"
PKG_CONFIG_SYSROOT_DIR="$$dunit_sysroot"
PKG_CONFIG_LIBDIR="$$dunit_sysroot/lib/pkgconfig:$$dunit_sysroot/share/pkgconfig"
PKG_CONFIG_PATH=
export CC AR STRIP PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_LIBDIR PKG_CONFIG_PATH
