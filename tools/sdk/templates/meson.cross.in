# Generated by tools/dunit_sdk.py. Target programs require Dunit/QEMU.
[constants]
root = '''${meson_root}'''
[binaries]
c = root / 'bin/x86_64-dunit-cc'
ar = root / 'bin/x86_64-dunit-ar'
strip = root / 'bin/x86_64-dunit-strip'
pkg-config = 'pkg-config'
[host_machine]
system = 'dunit'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
[properties]
needs_exe_wrapper = true
sys_root = root
pkg_config_libdir = [root / 'lib/pkgconfig', root / 'share/pkgconfig']
[built-in options]
pkg_config_path = []
