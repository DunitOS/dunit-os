{
  "description": "SDK push buttons: native focus/keyboard, stable keys across reorder/resize, pointer press/cancel/click, disabled exclusion.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-buttons.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[WIDGETS] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[WIDGETS] tab focus OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[WIDGETS] space and reorder OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[WIDGETS] skip disabled OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ret"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[WIDGETS] enter OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[WIDGETS] resize retained focus OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 100,
            "y": 90,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[WIDGETS] pointer pressed OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "wait_marker": "[WIDGETS] leave cancelled OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": 100,
            "y": 90,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "wait_marker": "[WIDGETS] returned without press OK",
          "timeout": 60
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[WIDGETS] buttons ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[WIDGETS] ready",
    "[WIDGETS] tab focus OK",
    "[WIDGETS] space and reorder OK",
    "[WIDGETS] skip disabled OK",
    "[WIDGETS] enter OK",
    "[WIDGETS] resize retained focus OK",
    "[WIDGETS] pointer pressed OK",
    "[WIDGETS] leave cancelled OK",
    "[WIDGETS] returned without press OK",
    "[WIDGETS] pointer activated OK",
    "[WIDGETS] buttons ok",
    "[GUI-EXIT] app=sdk_buttons_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
