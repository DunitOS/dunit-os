{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-progress.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[PROGRESS] timed busy OK",
          "timeout": 45
        },
        {
          "wait_marker": "[PROGRESS] reduced motion no timer OK",
          "timeout": 45
        },
        {
          "wait_marker": "[PROGRESS] ready",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] passive tab skip OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ret"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] model update OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 24,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 0,
            "repeat": 3,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 79,
            "y": 127,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 29,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": true
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": false
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[PROGRESS] passive pointer OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ret"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] next step OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ret"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] complete OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] pause no timer OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] resize focus OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] resume OK",
          "timeout": 45
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-progress.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "q"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[PROGRESS] ok",
          "timeout": 45
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[PROGRESS] timed busy OK",
    "[PROGRESS] reduced motion no timer OK",
    "[PROGRESS] ready",
    "[PROGRESS] passive tab skip OK",
    "[PROGRESS] model update OK",
    "[PROGRESS] passive pointer OK",
    "[PROGRESS] next step OK",
    "[PROGRESS] complete OK",
    "[PROGRESS] pause no timer OK",
    "[PROGRESS] resize focus OK",
    "[PROGRESS] resume OK",
    "[PROGRESS] ok",
    "[GUI-EXIT] app=sdk_progress_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
