{
  "description": "SDK defaults, automatic theme reload, preserved model and rejection rollback, verified against actual framebuffer captures.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-theme.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKTHEME] dark hash=",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.01
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-theme-dark.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKTHEME] light hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-theme-light.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKTHEME] restored hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-theme-restored.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKTHEME] ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKTHEME] dark hash=",
    "[SDKTHEME] light hash=",
    "[SDKTHEME] restored hash=",
    "[SDKTHEME] invalid retained OK",
    "[SDKTHEME] ok",
    "[GUI-EXIT] app=sdk_theme_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "gui_server: FAIL",
    "FAIL no frame done"
  ]
}
