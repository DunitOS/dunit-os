  "required": [
    "[TERM-007] Starting main loop",
    "[SCROLL] ready",
    "[SCROLL] tab focus OK",
    "[SCROLL] end OK",
    "[SCROLL] home OK",
    "[SCROLL] page down OK",
    "[SCROLL] up OK",
    "[SCROLL] wheel down OK",
    "[SCROLL] wheel up OK",
    "[SCROLL] track page OK",
    "[SCROLL] thumb drag OK",
    "[SCROLL] end before click OK",
    "[SCROLL] scrolled button OK",
    "[SCROLL] noop retained OK",
    "[SCROLL] resize retained OK",
    "[SCROLL] shrink clamped OK",
    "[SCROLL] expand fresh OK",
    "[SCROLL] ok",
    "[GUI-EXIT] app=sdk_scroll_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    {
      "marker": "[USER-FAULT]",
      "after": "[TERM-007] Starting main loop",
      "why": "Boot smoke intentionally faults isolated children before the terminal; no fault is allowed during the native GUI test."
    },
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
