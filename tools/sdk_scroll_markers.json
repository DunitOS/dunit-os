                "data": {
                  "down": false,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SCROLL] scrolled button OK",
          "timeout": 60
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-scroll-buttons.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "n"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] noop retained OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] resize retained OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "s"
