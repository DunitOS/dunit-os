            "x": 0,
            "y": -90,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "delay_ms": 200
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 40,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SCROLL] thumb drag OK",
