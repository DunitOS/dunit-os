{
  "description": "SDK scroll area: real keyboard, wheel, track paging, thumb drag, clipped scrolled button hit, stable update/resize and content shrink clamp.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-scroll.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SCROLL] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] tab focus OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "end"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] end OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] home OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "pgdn"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] page down OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "up"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] up OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 127,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 73,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 126,
            "y": 0,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "wheel-down"
                }
              }
            ]
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "wheel-down"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SCROLL] wheel down OK",
          "timeout": 60
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "wheel-up"
                }
              }
            ]
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "wheel-up"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SCROLL] wheel up OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 120,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 0,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 123,
            "y": 0,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "left"
