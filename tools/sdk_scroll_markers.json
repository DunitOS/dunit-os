        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "e"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SCROLL] expand fresh OK",
          "timeout": 60
