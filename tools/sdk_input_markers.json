{
  "description": "Native single-line fields: UTF8 boundaries, raw keyboard edit/navigation/selection/history, blink deadline, scroll, password/limit/read-only, pointer selection, resize.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-input.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[INPUT] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] focused OK",
          "timeout": 60
        },
        {
          "wait_marker": "[INPUT] blink timer OK",
          "timeout": 60
        },
        {
          "type_text": "abc",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] unicode typing OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "left"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "backspace"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] raw backspace OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "shift"
              },
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "type_text": "Z",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] shift selection replaced OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ctrl"
              },
              {
                "type": "qcode",
                "data": "z"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] undo OK",
          "timeout": 60
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ctrl"
              },
              {
                "type": "qcode",
                "data": "y"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] redo OK",
          "timeout": 60
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "delete"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] home delete OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ctrl"
              },
              {
                "type": "qcode",
                "data": "a"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "type_text": "q",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] select all OK",
          "timeout": 60
        },
        {
          "type_text": "01234567890123456789012345678901234567890123456789012345678901234567890123456789",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] long line scrolled OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "type_text": "secret",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] password and limit OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "delay_ms": 180
        },
        {
          "type_text": "x",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] read only OK",
          "timeout": 60
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-input-fields.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] resize retained OK",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 100,
            "y": 90,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": true,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "delay_ms": 180
        },
        {
          "relative_motion": {
            "x": 50,
            "y": 0,
            "repeat": 1,
            "interval": 0.02
          }
        },
        {
          "delay_ms": 180
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "down": false,
                  "button": "left"
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[INPUT] pointer selection OK",
          "timeout": 60
        },
        {
          "type_text": "X",
          "key_interval_ms": 60
        },
        {
          "wait_marker": "[INPUT] pointer replace OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "ctrl"
              },
              {
                "type": "qcode",
                "data": "backspace"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[INPUT] ctrl raw backspace OK",
          "timeout": 60
        },
        {
          "wait_marker": "[INPUT] ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[INPUT] ready",
    "[INPUT] focused OK",
    "[INPUT] blink timer OK",
    "[INPUT] unicode typing OK",
    "[INPUT] raw backspace OK",
    "[INPUT] shift selection replaced OK",
    "[INPUT] undo OK",
    "[INPUT] redo OK",
    "[INPUT] home delete OK",
    "[INPUT] select all OK",
    "[INPUT] long line scrolled OK",
    "[INPUT] password and limit OK",
    "[INPUT] read only OK",
    "[INPUT] resize retained OK",
    "[INPUT] pointer selection OK",
    "[INPUT] pointer replace OK",
    "[INPUT] ctrl raw backspace OK",
    "[INPUT] ok",
    "[GUI-EXIT] app=sdk_input_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
