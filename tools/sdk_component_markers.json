{
  "description": "Typed Component: native keyboard update, bounded CPU repaint, maximize/restore with model state, clean close",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-component.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKUI] ready",
          "timeout": 60
        },
        {
          "wait_marker": "[DAMAGE] scene reusable",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKUI] partial repaint OK",
          "timeout": 30
        },
        {
          "wait_marker": "[DAMAGE] partial frame OK",
          "timeout": 30
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SDKUI] resized OK",
          "timeout": 60
        },
        {
          "delay_ms": 300
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "m"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SDKUI] restored OK",
          "timeout": 60
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "q"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "meta_l"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[GUI-EXIT] app=sdk_component_fixture kind=0 code=0",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKUI] ready",
    "[SDKUI] input update OK",
    "[SDKUI] partial repaint OK",
    "[SDKUI] resized OK",
    "[SDKUI] restored OK",
    "[SDKUI] ok",
    "[GUI-EXIT] app=sdk_component_fixture kind=0 code=0",
    "[DAMAGE] partial frame OK",
    "[DAMAGE] partial composed=15360 presented=15360 texture=15360",
    "[SDKUI] unchanged frame skipped OK",
    "[SDKUI] reused buffer upload OK"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
