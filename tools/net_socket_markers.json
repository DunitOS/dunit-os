{
  "description": "Production netd handles authorized outbound UDP and TCP descriptors through isolated E1000.",
  "run": {
    "config": "limine_test_gui.conf",
    "initrd_overlay": "tests/fixtures/net-socket",
    "net_socket": true,
    "ready_marker": "[INIT] start: PID 1 userspace service manager",
    "actions": [
      {"wait_marker": "[NET-SOCKET] complete", "timeout": 90},
      {"wait_marker": "gui_server: desktop ready", "timeout": 60}
    ]
  },
  "required": [
    {"marker": "[NETD] IPv4 static bound 192.0.2.12", "source": "userspace/system_apps/netd/src/static_runtime.rs"},
    {"marker": "[NET-SOCKET] child denied inherited fd and grant", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    {"marker": "[NET-SOCKET] UDP validated truncation and copyout retry", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    {"marker": "[NET-SOCKET] TCP validated partial I/O and EOF", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    {"marker": "[NET-SOCKET] TCP reset woke wait-set and returned EPIPE", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    {"marker": "[NETD] IPv4 static conflict 192.0.2.12", "source": "userspace/system_apps/netd/src/static_runtime.rs"},
    {"marker": "[NET-SOCKET] address withdrawal revoked socket and woke wait-set", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    {"marker": "[NET-SOCKET] complete", "source": "userspace/system_apps/net_socket_test/src/main.rs"},
    "gui_server: desktop ready"
  ],
  "forbidden": [
    "[PANIC]",
    "[INIT] PANIC in init",
    "[INIT] netd: restart",
    "[INIT] netd: faulted",
    "[NET-SOCKET] FAIL",
    "[NETD-FIXTURE]",
    {"marker": "[USER-FAULT]", "after": "[INIT] start: PID 1 userspace service manager"}
  ]
}
