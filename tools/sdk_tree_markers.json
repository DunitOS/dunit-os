        {
          "wait_marker": "[TREE] ready",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[TREE] tab focus OK",
          "timeout": 45
