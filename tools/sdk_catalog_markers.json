{
  "description": "Installed GUI manifest resolves real dock/launcher/startup and launches an unrelated ELF target",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /assets/dwm/tests/sdk-catalog.toml",
      "exec /app/sdk_catalog_test",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_stat: SDK wait-set refresh OK",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "gui_stat: SDK reconfigured OK",
          "timeout": 30
        },
        {
          "delay_ms": 300
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "gui_stat: SDK restored size=460x300",
          "timeout": 30
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "q"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "gui_stat: SDK quit OK",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "setup: full desktop applied",
    "[SDKCAT] manifest resolved dock launcher startup OK",
    "[SDKCAT] metadata reread OK",
    "[SDKCAT] invalid candidate rejected and recovery OK",
    "[EXEC] /app/sdk_catalog_test returned code=0",
    "gui_stat: surface presented OK",
    "gui_stat: typed component presented OK",
    "gui_stat: SDK wait-set refresh OK",
    "gui_server: desktop ready",
    "gui_stat: SDK quit OK",
    "gui_stat: SDK reconfigured OK",
    "gui_stat: SDK restored size=460x300"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "gui_stat: FAIL",
    "gui_server: FAIL"
  ]
}
