{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-slider.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SLIDER] ready",
          "timeout": 60
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] focus OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "right"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] arrow step OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "end"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] end OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "right"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] endpoint no duplicate OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] home OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "pgup"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] page up OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "pgdn"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] page down OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 24,
            "interval": 0.01
          }
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 0,
            "repeat": 4,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 22,
            "y": 127,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 0,
            "y": 37,
            "interval": 0.02
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": true
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SLIDER] track click OK",
          "timeout": 45
        },
        {
          "relative_motion": {
            "x": 127,
            "y": 0,
            "interval": 0.02
          }
        },
        {
          "relative_motion": {
            "x": 23,
            "y": 0,
            "interval": 0.02
          }
        },
        {
          "wait_marker": "[SLIDER] captured drag clamp OK",
          "timeout": 45
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "btn",
                "data": {
                  "button": "left",
                  "down": false
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[SLIDER] release OK",
          "timeout": 45
        },
        {
          "delay_ms": 250
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-slider.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] tab and button OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "meta_l"
              },
              {
                "type": "qcode",
                "data": "m"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] resize focus OK",
          "timeout": 45
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "shift"
              },
              {
                "type": "qcode",
                "data": "tab"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "home"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SLIDER] resized keyboard OK",
          "timeout": 45
        },
        {
          "wait_marker": "[SLIDER] ok",
          "timeout": 45
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SLIDER] ready",
    "[SLIDER] focus OK",
    "[SLIDER] arrow step OK",
    "[SLIDER] end OK",
    "[SLIDER] endpoint no duplicate OK",
    "[SLIDER] home OK",
    "[SLIDER] page up OK",
    "[SLIDER] page down OK",
    "[SLIDER] track click OK",
    "[SLIDER] captured drag clamp OK",
    "[SLIDER] release OK",
    "[SLIDER] tab and button OK",
    "[SLIDER] resize focus OK",
    "[SLIDER] resized keyboard OK",
    "[SLIDER] ok",
    "[GUI-EXIT] app=sdk_slider_fixture kind=0 code=0"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "application failed:",
    "gui_server: FAIL",
    "gui_server: PANIC"
  ]
}
