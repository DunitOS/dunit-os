{
  "description": "Shared SDK effects: rounded gradient card, partial shadow repair, dark/light reload, actual framebuffer goldens.",
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /app/setup import-desktop /sdk-effects.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[SDKEFFECTS] dark hash=",
          "timeout": 60
        },
        {
          "relative_motion": {
            "x": -127,
            "y": -127,
            "repeat": 30,
            "interval": 0.01
          }
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-effects-dark.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKEFFECTS] narrow hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-effects-narrow.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKEFFECTS] light hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-effects-light.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKEFFECTS] restored hash=",
          "timeout": 60
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/sdk-effects-restored.ppm"
          }
        },
        {
          "execute": "send-key",
          "arguments": {
            "keys": [
              {
                "type": "qcode",
                "data": "spc"
              }
            ],
            "hold-time": 80
          }
        },
        {
          "wait_marker": "[SDKEFFECTS] ok",
          "timeout": 60
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "[SDKEFFECTS] dark hash=",
    "[SDKEFFECTS] light hash=",
    "[SDKEFFECTS] restored hash=",
    "[SDKEFFECTS] ok",
    "[GUI-EXIT] app=sdk_effects_fixture kind=0 code=0",
    "[SDKEFFECTS] narrow hash=",
    "[SDKEFFECTS] partial repair OK"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "gui_server: FAIL",
    "FAIL no frame done"
  ]
}
