{
  "run": {
    "config": "limine_test_terminal.conf",
    "cmd": [
      "exec /system/bin/tcc /assets/tcc/gui.c -o /tmp/c-gui -ldunit_ui",
      "exec /app/setup import-desktop /assets/tcc/gui.toml",
      "exec /app/gui_server"
    ],
    "command_actions": {
      "exec /app/gui_server": [
        {
          "wait_marker": "gui_server: desktop ready",
          "timeout": 60
        },
        {
          "wait_marker": "[GUI-PRESENT] app=c_gui",
          "timeout": 60
        },
        {
          "delay_ms": 1000
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/c-ui-initial.ppm"
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "tab"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "tab"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "spc"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "spc"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[CGUI] count 1",
          "timeout": 30
        },
        {
          "delay_ms": 200
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "spc"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "spc"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[CGUI] count 2",
          "timeout": 30
        },
        {
          "delay_ms": 1000
        },
        {
          "execute": "screendump",
          "arguments": {
            "filename": "build/c-ui-updated.ppm"
          }
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "tab"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "tab"
                  }
                }
              }
            ]
          }
        },
        {
          "delay_ms": 100
        },
        {
          "execute": "input-send-event",
          "arguments": {
            "events": [
              {
                "type": "key",
                "data": {
                  "down": true,
                  "key": {
                    "type": "qcode",
                    "data": "ret"
                  }
                }
              },
              {
                "type": "key",
                "data": {
                  "down": false,
                  "key": {
                    "type": "qcode",
                    "data": "ret"
                  }
                }
              }
            ]
          }
        },
        {
          "wait_marker": "[CGUI] ok",
          "timeout": 30
        },
        {
          "wait_marker": "[GUI-EXIT] app=c_gui kind=0 code=0",
          "timeout": 30
        }
      ]
    }
  },
  "required": [
    "[TERM-007] Starting main loop",
    "gui_server: desktop ready",
    "[GUI-PRESENT] app=c_gui",
    "[CGUI] bad version and invalid tree rejected",
    "[CGUI] nested run rejected",
    "[CGUI] count 1",
    "[CGUI] count 2",
    "[CGUI] ok",
    "[GUI-EXIT] app=c_gui kind=0 code=0",
    "[CGUI] repeat run rejected"
  ],
  "forbidden": [
    "[PANIC]",
    "[SDK] PANIC",
    "tcc: error",
    "gui_server: FAIL",
    "setup: error:",
    "setup: fatal error"
  ]
}
