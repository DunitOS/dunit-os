// Shared shell tokens. Legacy [theme] fields become explicit overrides.
$shell-desktop: $window-bg;
$shell-title-focused: $surface;
$shell-title-unfocused: $window-bg;
$shell-border-focused: $accent;
$shell-border-unfocused: $line;
$shell-close: $accent;
$shell-minimize: $muted;
$shell-maximize: $accent;
$shell-panel: $surface;
$shell-panel-text: $text;
$shell-launcher: $accent;
$shell-taskbtn: $surface;
$shell-taskbtn-focused: $line;
$shell-menu: $surface;
$shell-menu-hover: $line;
$shell-title-text-focused: $text;
$shell-title-text-unfocused: $muted;

// Shared shell paint metrics; resolved once before a scene is accepted.
$shell-hover-alpha: 192;
$shell-hover-radius: 5;
$shell-hover-inset-x: 3;
$shell-hover-inset-y: 2;
$shell-menu-text-inset: 8;
$shell-menu-icon-inset: 6;
$shell-menu-icon-padding: 8;
$shell-menu-icon-min: 8;
$shell-menu-icon-max: 22;
$shell-overlay-gradient-top: 14;
$shell-desktop-gradient-top: 12;
$shell-desktop-gradient-bottom: -8;
$shell-switcher-tile: 64;
$shell-switcher-gap: 12;
$shell-switcher-padding: 20;
$shell-switcher-label-height: 24;
$shell-switcher-radius: 16;
$shell-switcher-shadow: 10;
$shell-switcher-shadow-alpha: 90;
$shell-switcher-alpha: 240;
$shell-switcher-highlight-inset: 4;
$shell-switcher-highlight-radius: 10;
$shell-switcher-icon-inset: 6;
$shell-switcher-text-inset: 8;
$shell-switcher-font-size: 15;
$shell-switcher-baseline-inset: 6;
$shell-qs-width: 150;
$shell-qs-padding: 4;
$shell-qs-radius: 10;
$shell-qs-shadow: 10;
$shell-qs-shadow-alpha: 90;
$shell-qs-hover-inset: 2;
$shell-qs-label-inset: 10;
$shell-qs-baseline-offset: 5;
$shell-qs-toggle-width: 22;
$shell-qs-toggle-height: 12;
$shell-qs-toggle-margin: 8;
$shell-qs-knob-inset: 2;
$shell-notification-margin: 16;
$shell-notification-height: 30;
$shell-notification-gap: 8;
$shell-notification-padding: 15;
$shell-notification-min-width: 96;
$shell-notification-slide: 12;
$shell-notification-radius: 10;
$shell-notification-shadow: 8;
$shell-notification-shadow-alpha: 80;
$shell-notification-accent-inset: 4;
$shell-notification-accent-width: 4;
$shell-notification-accent-radius: 2;
$shell-notification-text-inset: 14;
$shell-notification-baseline-offset: 5;
$shell-widget-width: 236;
$shell-widget-padding: 16;
$shell-widget-clock-gap: 10;
$shell-widget-monitor-height: 58;
$shell-widget-margin: 24;
$shell-widget-gradient-top: 16;
$shell-widget-gradient-bottom: -8;
$shell-widget-clock-baseline-inset: 4;
$shell-widget-bar-gap: 12;
$shell-widget-bar-height: 8;
$shell-widget-bar-radius: 4;
$shell-widget-bar-shade: -20;
$shell-group-list-width: 220;
$shell-group-row-height: 40;
$shell-group-padding: 8;
$shell-group-fan-size: 80;
$shell-group-fan-step-x: 20;
$shell-group-fan-step-y: 28;
$shell-group-grid-cell: 64;
$shell-group-columns: 4;
$shell-cursor-outline: #000000;
$shell-cursor-fill: #ffffff;
$shell-toggle-knob: #ffffff;

// Legacy strip/decorations defaults. Explicit TOML numeric fields override these.
$shell-layout-title-h: 26;
$shell-layout-border: 2;
$shell-layout-panel-h: 28;
$shell-layout-launcher-w: 92;
$shell-layout-taskbtn-w: 120;
$shell-layout-taskbtn-gap: 4;
$shell-layout-menu-w: 130;
$shell-layout-menu-item-h: 26;
$shell-layout-dock-w: 48;
$shell-layout-dock-padding: 6;
$shell-layout-dock-gap: 6;
$shell-layout-dock-margin: 0;
$shell-layout-dock-tile-alpha: 255;
$shell-layout-ws-w: 22;
$shell-layout-title-font-px: 14;
$shell-layout-panel-font-px: 13;
$shell-effects-corner-radius: 8;
$shell-effects-shadow: 7;
$shell-effects-shadow-alpha: 90;
$shell-effects-blur-radius: 4;
$shell-effects-blur-iters: 2;
$shell-effects-panel-alpha: 205;
$shell-effects-menu-alpha: 225;
$shell-effects-anim-ms: 140;

$shell-cursor-source: /assets/dwm/cursor.txt;

// Window controls and retained shell details share the same registry.
$shell-control-size-inset: 12;
$shell-control-min-size: 4;
$shell-control-left-inset: 8;
$shell-control-left-gap: 6;
$shell-control-right-inset: 6;
$shell-control-right-gap: 4;
$shell-control-glyph-min: 3;
$shell-control-glyph-stroke: 1;
$shell-title-baseline-offset: 5;
$shell-title-text-inset: 12;
$shell-border-gradient-top: 18;
$shell-border-gradient-bottom: -12;
$shell-title-gradient-top: 16;
$shell-title-gradient-bottom: -10;
$shell-panel-gradient-top: 12;
$shell-panel-gradient-bottom: -10;
$shell-running-width: 6;
$shell-running-height: 3;
$shell-running-radius: 1;
$shell-icon-padding: 6;
$shell-logo-padding: 8;
$shell-logo-max-size: 24;
$shell-logo-gap: 4;
$shell-logo-raster-size: 32;
$shell-icon-raster-padding: 6;
$shell-icon-raster-min: 32;
$shell-component-clock-padding: 16;
$shell-component-label-padding: 24;
$shell-component-monitor-width: 160;
$shell-component-tray-width: 210;
$shell-component-title-width: 160;
$shell-component-text-padding: 8;
$shell-component-baseline-inset: 2;
$shell-clock-padding: 3;
$shell-clock-tick-size: 2;
$shell-clock-hour-percent: 50;
$shell-clock-minute-percent: 80;
$shell-clock-second-percent: 90;
$shell-placement-origin-x: 90;
$shell-placement-step: 40;
$shell-placement-columns: 6;
$shell-placement-startup-step: 32;

$shell-shadow-color: #000000;
$shell-shadow-offset: 2;
$shell-layer-shadow-alpha: 80;

$shell-group-preview-columns: 2;
$shell-group-preview-rows: 2;
$shell-component-raster-min: 16;

// Initial client slots are also appearance/placement data, before desktop entry.
$shell-startup-origin-x: 300;
$shell-startup-origin-y: 100;
$shell-startup-step-x: 70;
$shell-startup-step-y: 90;
