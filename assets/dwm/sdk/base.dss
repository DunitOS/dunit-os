// Structural defaults shared by SDK profiles. Appearance comes from tokens.
Row, Column, Stack, Grid { background: $window-bg; padding: $space; }
Text { color: $text; font-size: $font-size; padding: $space-small; }
Text#title { color: $accent; font-size: $font-title; }

// Button behaviour is supplied by the SDK; DSS describes its states only.
Button, ToggleButton { background: $surface; color: $text; font-size: $font-size; padding: $space-small; radius: $radius; border-width: $border; border-color: $line; }
Button:hover, ToggleButton:hover { border-color: $accent; }
Button:focus, ToggleButton:focus { border-color: $accent; }
Button:active, ToggleButton:active { background: $accent; color: $window-bg; }
Button:disabled, ToggleButton:disabled { color: $muted; border-color: $line; }

ToggleButton:checked { background: $accent; color: $window-bg; }
ToggleButton:disabled:checked { color: $muted; }
Checkbox, Radio, Switch { border-width: $border; border-color: $indicator-off; radius: $radius; color: $text; font-size: $font-size; padding: $space-small; indicator-width: $indicator-size; indicator-height: $indicator-size; indicator-gap: $indicator-gap; indicator-border-width: $border; indicator-radius: $indicator-radius; indicator-background: $surface; indicator-border-color: $line; indicator-mark-color: $indicator-off; indicator-mark-size: $indicator-mark-size; indicator-inset: $indicator-inset; indicator-position: $indicator-start; }
Radio { indicator-radius: $indicator-round-radius; indicator-mark-size: $indicator-dot-size; }
Switch { indicator-width: $switch-width; indicator-radius: $indicator-round-radius; indicator-mark-color: $text; }
Checkbox:hover, Radio:hover, Switch:hover { indicator-border-color: $accent; }
Checkbox:focus, Radio:focus, Switch:focus { border-color: $accent; }
Checkbox:checked, Radio:checked { indicator-mark-color: $accent; }
Switch:checked { indicator-background: $accent; indicator-position: $indicator-end; }
Checkbox:active, Radio:active, Switch:active { indicator-background: $line; indicator-border-color: $accent; }
Checkbox:disabled, Radio:disabled, Switch:disabled { color: $muted; indicator-background: $surface; indicator-border-color: $line; }
Switch:disabled:checked { indicator-background: $accent; }
Checkbox:disabled:checked, Radio:disabled:checked, Switch:disabled { indicator-mark-color: $muted; }

// Input editing is retained by the SDK; every visual metric is theme supplied.
Input, Textarea, Spinbox { background: $surface; color: $text; font-size: $font-size; padding: $space-small; radius: $radius; border-width: $border; border-color: $line; placeholder-color: $muted; selection-color: $input-selection; caret-color: $text; caret-width: $caret-width; caret-blink: $caret-blink; scroll-step: $input-scroll-step; selection-scroll-interval: $selection-scroll-interval; selection-scroll-step: $selection-scroll-step; }
Input:hover, Input:focus, Textarea:hover, Textarea:focus, Spinbox:hover, Spinbox:focus { border-color: $accent; }
Input:read-only, Textarea:read-only, Spinbox:read-only { background: $window-bg; }
Input:disabled, Textarea:disabled, Spinbox:disabled { color: $muted; caret-color: $indicator-off; border-color: $line; }

// Viewport behavior is SDK-owned; gutter and scrollbar appearance are themed.
Scroll { background: $surface; padding: $space-small; border-width: $border; border-color: $line; radius: $radius; scrollbar-width: $scrollbar-width; scrollbar-min-thumb: $scrollbar-min-thumb; scrollbar-radius: $scrollbar-radius; scrollbar-track: $window-bg; scrollbar-thumb: $muted; scroll-step: $scroll-step; }
Scroll:focus { border-color: $accent; }
Scroll:hover { scrollbar-thumb: $accent; }
Scroll:disabled { scrollbar-thumb: $line; }

// Textarea uses the same themed bars and fixed gutters on both axes.
Textarea { scrollbar-width: $scrollbar-width; scrollbar-min-thumb: $scrollbar-min-thumb; scrollbar-radius: $scrollbar-radius; scrollbar-track: $window-bg; scrollbar-thumb: $muted; }
Textarea:hover, Textarea:focus { scrollbar-thumb: $accent; }
Textarea:disabled { scrollbar-thumb: $line; }

Slider, VerticalSlider { padding: $space-small; border-width: $border; border-color: $indicator-off; radius: $radius; slider-thumb-size: $slider-thumb-size; slider-track-height: $slider-track-height; slider-min-track: $slider-min-track; slider-track-color: $line; slider-fill-color: $accent; slider-thumb-color: $text; }
Slider:hover, VerticalSlider:hover, Slider:active, VerticalSlider:active { slider-thumb-color: $accent; }
Slider:focus, VerticalSlider:focus { border-color: $accent; }
Slider:disabled, VerticalSlider:disabled { slider-fill-color: $muted; slider-thumb-color: $muted; }

Spinbox { spinbox-button-width: $spinbox-button-width; spinbox-mark-size: $spinbox-mark-size; spinbox-mark-width: $border; spinbox-button-color: $line; spinbox-pressed-color: $accent; spinbox-disabled-color: $muted; }

Progress, Busy { padding: $space-small; progress-thickness: $progress-thickness; progress-min-track: $progress-min-track; progress-radius: $radius; progress-track-color: $line; progress-fill-color: $accent; busy-segment: $busy-segment; busy-duration: $busy-duration; busy-interval: $busy-interval; }
Progress:disabled, Busy:disabled { progress-fill-color: $muted; }

Row.menu-bar { padding: 0; }
MenuButton, Select { background: $surface; color: $text; font-size: $font-size; padding: $space-small; radius: $radius; border-width: $border; border-color: $line; tooltip-delay: $tooltip-delay; }
MenuButton:hover, MenuButton:focus, MenuButton:expanded, Select:hover, Select:focus, Select:expanded { border-color: $accent; }
MenuButton:active, MenuButton:expanded { background: $line; }
MenuButton:disabled, Select:disabled { color: $muted; }
Select { control-suffix: $select-mark; }
Popup { background: $surface; border-width: $border; border-color: $line; radius: $radius; padding: $space-small; clip: rounded; menu-min-width: $menu-min-width; menu-gap: $menu-gap; }
MenuItem { color: $text; font-size: $font-size; padding: $space-small; menu-row-height: $menu-row-height; menu-submenu-mark: $menu-submenu-mark; }
MenuItem:checked { background: $line; }
MenuItem:focus, MenuItem:active { background: $accent; color: $window-bg; }
MenuItem:disabled { color: $muted; }
MenuSeparator { background: $line; menu-separator-height: $border; }
Tooltip { background: $surface; border-width: $border; border-color: $accent; padding: $space-small; radius: $radius; tooltip-gap: $tooltip-gap; tooltip-max-width: $tooltip-max-width; }
TooltipText { color: $text; font-size: $font-size; }
// Tooltip delay applies to every SDK element that declares a tooltip.
Text, Row, Column, Stack, Grid, Button, ToggleButton, Checkbox, Radio, Switch, Input, Textarea, Spinbox, Slider, VerticalSlider, Progress, Busy, Scroll { tooltip-delay: $tooltip-delay; }
