// SDK light profile, using the same token contract as the dark profile.
$window-bg: #f4f6fa;
$surface: #ffffff;
$text: #202938;
$muted: #526278;
$accent: #005fa8;
$line: #b7c2d0;
$font-size: 14;
$font-title: 20;
$space: 12;
$space-small: 4;
$radius: 6;
$border: 1;
$motion-fast: 160ms;

$shadow: #18203050;
$shadow-y: 4;
$shadow-spread: 10;

$glass-tint: #ffffff60;
$glass-radius: 20;
$blur-radius: 6;

// Shared checkable-control geometry and state values.
$indicator-size: 18;
$indicator-gap: 8;
$indicator-radius: 3;
$indicator-round-radius: 9;
$indicator-mark-size: 14;
$indicator-dot-size: 8;
$indicator-inset: 2;
$switch-width: 34;
$indicator-off: #00000000;
$indicator-start: 0;
$indicator-end: 1;

$input-selection: #b9dcf5;
$caret-width: 1;
$caret-blink: 500ms;

$input-scroll-step: 3;
