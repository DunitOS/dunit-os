// SDK light profile, using the same token contract as the dark profile.
$window-bg: #f4f6fa;
$surface: #ffffff;
$text: #202938;
$muted: #526278;
$accent: #005fa8;
$line: #b7c2d0;
$font-size: 14;
$font-title: 20;
$space: 12;
$space-small: 4;
$radius: 6;
$border: 1;
$motion-fast: 160ms;

$shadow: #18203050;
$shadow-y: 4;
$shadow-spread: 10;

$glass-tint: #ffffff60;
$glass-radius: 20;
$blur-radius: 6;

// Shared checkable-control geometry and state values.
$indicator-size: 18;
$indicator-gap: 8;
$indicator-radius: 3;
$indicator-round-radius: 9;
$indicator-mark-size: 14;
$indicator-dot-size: 8;
$indicator-inset: 2;
$switch-width: 34;
$indicator-off: #00000000;
$indicator-start: 0;
$indicator-end: 1;

$input-selection: #b9dcf5;
$caret-width: 1;
$caret-blink: 500ms;
$input-multiclick-interval: 400ms;
$input-multiclick-distance: 5;

$input-scroll-step: 3;

$scrollbar-hide-delay: 1200ms;
$scrollbar-width: 12;
$scrollbar-min-thumb: 24;
$scrollbar-radius: 4;
$scroll-step: 32;

$selection-scroll-interval: 32ms;
$selection-scroll-step: 12;

$slider-thumb-size: 18;
$slider-track-height: 4;
$slider-min-track: 120;

$spinbox-button-width: 24;
$spinbox-mark-size: 8;

$progress-thickness: 8;
$progress-min-track: 120;
$busy-segment: 0.25;
$busy-duration: 1200ms;
$busy-interval: 40ms;

$menu-min-width: 160;
$menu-row-height: 28;
$menu-gap: 0;
$menu-submenu-mark: >;
$select-mark: v;
$tooltip-delay: 600ms;
$tooltip-gap: 6;
$tooltip-max-width: 320;

$splitter-thickness: 8;
$dialog-width: 360;
$message-body-height: 96;
$dialog-scrim: #00000088;
$list-row-height: 28;

$tree-indent: 20;
$tree-toggle-width: 20;

$table-header-height: 32;
$table-column-width: 140;

$file-picker-width: 600;
$file-picker-height: 360;
$file-picker-window-width: 640;
$file-picker-window-height: 500;
