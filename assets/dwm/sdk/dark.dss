// SDK dark profile. Named values are also available through Theme::tokens.
$window-bg: #121820;
$surface: #1c2630;
$text: #cdd6f4;
$muted: #96a4b4;
$accent: #62b5e5;
$line: #344454;
$font-size: 14;
$font-title: 20;
$space: 12;
$space-small: 4;
$radius: 6;
$border: 1;
$motion-fast: 160ms;

$shadow: #00000090;
$shadow-y: 4;
$shadow-spread: 10;

$glass-tint: #12182060;
$glass-radius: 20;
$blur-radius: 6;

// Shared checkable-control geometry and state values.
$indicator-size: 18;
$indicator-gap: 8;
$indicator-radius: 3;
$indicator-round-radius: 9;
$indicator-mark-size: 14;
$indicator-dot-size: 8;
$indicator-inset: 2;
$switch-width: 34;
$indicator-off: #00000000;
$indicator-start: 0;
$indicator-end: 1;

$input-selection: #305777;
$caret-width: 1;
$caret-blink: 500ms;

$input-scroll-step: 3;

$scrollbar-width: 12;
$scrollbar-min-thumb: 24;
$scrollbar-radius: 4;
$scroll-step: 32;
